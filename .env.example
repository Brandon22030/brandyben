# Supabase — copie ce fichier en .env.local et remplis avec les valeurs
# de ton projet (Supabase dashboard → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role — serveur uniquement, jamais exposée au client.
# Utilisée pour gérer les comptes admin (Auth Admin API) depuis /admin/parametres.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — notification e-mail du formulaire de contact.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=brandonmedehou2203@gmail.com
